# --- Generation (optional) ---
# Precedence: weak-retrieval refuse → Ollama (if reachable) → OpenAI (if key) → offline quotes.
# Embeddings are ALWAYS local (Xenova/all-MiniLM-L6-v2); never sent to OpenAI or Ollama for embedding.
# OpenAI is NOT required for the Premium demo.

# Local Ollama (preferred for privacy — docs/chunks stay on your machine)
# Install: https://ollama.com  then:  ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Cloud OpenAI-compatible chat (used only when Ollama is down / unreachable)
OPENAI_API_KEY=
# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Premium agent actions ---
# Optional: real webhook destination for “Send webhook”. If unset, CiteQA simulates success and logs locally.
WEBHOOK_URL=

# Optional: gate /admin behind a simple demo password (portfolio usually leaves this empty)
ADMIN_DEMO_PASSWORD=
